{
	"name": "PL_SRC_SILVER_SUB1",
	"properties": {
		"activities": [
			{
				"name": "Read table Details",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT  * FROM [ctrl].[table_config] \nwhere is_active =1 \nand source_system = '@{pipeline().parameters.sourceSystem}'\nand table_id = @{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DSAzureSqlData",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set Start Time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "startTime",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy/MM/ddThh:mm:ss') ",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Src to landing injestion",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "If Condition2",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "select * \nfrom public.@{activity('Read table Details').output.firstRow.source_table_name} \n@(\n    if(equals(activity('Read table Details').output.firstRow.load_type,'FULL')\n    ,'' \n    ,concat(\n            'where ',equals(activity('Read table Details').output.firstRow.watermark_column,' > ','''',variables('watermark_value'),''''\n            )\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_PostgreSql",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_Parquet",
						"type": "DatasetReference",
						"parameters": {
							"container": "ext-adls-unity-catalog",
							"folder": {
								"value": "@concat(\n    'caresync',\n    '/',\n    activity('Read table Details').output.firstRow.source_system,\n    '/',\n    activity('Read table Details').output.firstRow.source_table_name,\n    '/',\n    variables('startTime'),\n    '/'\n)",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "landing_To_Bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Src to landing injestion",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/caresync_health_ws/EE_CaresyncProject_ADB/landing_To_Bronze",
					"baseParameters": {
						"source_system": {
							"value": "@activity('Read table Details').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Read table Details').output.firstRow.source_table_name",
							"type": "Expression"
						},
						"date": {
							"value": "@{formatDateTime(utcNow(),'dd')}",
							"type": "Expression"
						},
						"month": {
							"value": "@{formatDateTime(utcNow(),'MM')}",
							"type": "Expression"
						},
						"year": {
							"value": "@{formatDateTime(utcNow(),'yyyy')}",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('landing_timestamp')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "bronze_to_silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "landing_To_Bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/caresync_health_ws/EE_CaresyncProject_ADB/bronze_to_silver",
					"baseParameters": {
						"table_name": {
							"value": "@activity('Read table Details').output.firstRow.source_table_name",
							"type": "Expression"
						},
						"load_type": {
							"value": "@activity('Read table Details').output.firstRow.load_type",
							"type": "Expression"
						},
						"merge_keys": {
							"value": "@coalesce(activity('Read table Details').output.firstRow.merge_keys,'')",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('landing_timestamp')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Insert Success",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "bronze_to_silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSqlDatabase",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update ctrl.audit_log \nset status = 'SUCCESS' ,end_time =sysutcdatetime(), records_written= @{activity('bronze_to_silver').output.runOutput}\nwhere adf_run_id ='@{pipeline().parameters.adf_run_id}'\nand table_id = @{pipeline().parameters.table_id}",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "If Condition2",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Set Start Time",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Read table Details",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read table Details').output.load_type,'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "CheckWatermarkTbl",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "SELECT watermark_value FROM [ctrl].[watermark] where table_id = @{pipeline().parameters.table_id}",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DSAzureSqlData",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Set Watermark",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "CheckWatermarkTbl",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "watermark_value",
								"value": {
									"value": "@activity('CheckWatermarkTbl').output.firstRow.watermark_value",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string"
			},
			"adf_run_id": {
				"type": "string"
			},
			"sourceSystem": {
				"type": "string"
			}
		},
		"variables": {
			"startTime": {
				"type": "String"
			},
			"watermark_value": {
				"type": "String"
			},
			"landing_timestamp": {
				"type": "String"
			}
		},
		"annotations": []
	}
}